[ext_resource type="Script" uid="uid://yr3rit5uoix7" path="res://scripts/data/dialogue_data.gd" id="1_data"]
[ext_resource type="Script" uid="uid://cxuj4i20nvims" path="res://scripts/data/dialogue_line.gd" id="2_line"]

[sub_resource type="Resource" id="Resource_line1"]
script = ExtResource("2_line")
speaker = "Tomato Villager"
text = "Welcome to the camp! Every tomato you carry is a life — lose them all in the dungeon and you're back here."

[sub_resource type="Resource" id="Resource_line2"]
script = ExtResource("2_line")
speaker = "Tomato Villager"
text = "Plant, water and harvest tomatoes here to grow your numbers. Go poke around — I'll chime in when you find something new."

[resource]
script = ExtResource("1_data")
lines = Array[ExtResource("2_line")]([SubResource("Resource_line1"), SubResource("Resource_line2")])
