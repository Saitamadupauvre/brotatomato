[gd_resource type="Resource" script_class="DialogueData" format=3]

[ext_resource type="Script" uid="uid://yr3rit5uoix7" path="res://scripts/data/dialogue_data.gd" id="1_data"]
[ext_resource type="Script" uid="uid://cxuj4i20nvims" path="res://scripts/data/dialogue_line.gd" id="2_line"]

[sub_resource type="Resource" id="Resource_line1"]
script = ExtResource("2_line")
speaker = "Tomato Villager"
text = "That's a plot. Press E on it with a crop in hand to plant a seed."

[sub_resource type="Resource" id="Resource_line2"]
script = ExtResource("2_line")
speaker = "Tomato Villager"
text = "Press E again with water to water it, then wait for it to grow."

[sub_resource type="Resource" id="Resource_line3"]
script = ExtResource("2_line")
speaker = "Tomato Villager"
text = "Once it's ripe, press E to harvest — that's a new life, right there. Press G to place a new plot when you have materials."

[resource]
script = ExtResource("1_data")
lines = Array[ExtResource("2_line")]([SubResource("Resource_line1"), SubResource("Resource_line2"), SubResource("Resource_line3")])
